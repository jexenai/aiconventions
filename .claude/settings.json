{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.prod*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.prod*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  }
}
