{
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(**/.env.prod*)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.prod*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)"
    ],
    "allow": [
      "Bash(git rev-parse *)",
      "Bash(git init)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(xargs -0 git add *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(php artisan migrate*)",
      "Bash(php artisan db:*)"
    ]
  }
}